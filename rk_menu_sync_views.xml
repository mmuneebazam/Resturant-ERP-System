<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rk_menu_sync_list" model="ir.ui.view">
        <field name="name">rk.menu.sync.list</field>
        <field name="model">rk.menu.sync</field>
        <field name="arch" type="xml">
            <list string="Menu sync" editable="bottom" decoration-danger="state == 'drift'" decoration-muted="state == 'blocked'">
                <field name="platform_id"/>
                <field name="product_id"/>
                <field name="external_sku"/>
                <field name="our_price"/>
                <field name="platform_price"/>
                <field name="is_available"/>
                <field name="state" widget="badge"/>
                <field name="last_sync"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="action_rk_menu_sync" model="ir.actions.act_window">
        <field name="name">Menu sync</field>
        <field name="res_model">rk.menu.sync</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

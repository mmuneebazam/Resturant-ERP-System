<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rk_indent_list" model="ir.ui.view">
        <field name="name">rk.indent.list</field>
        <field name="model">rk.indent</field>
        <field name="arch" type="xml">
            <list string="Indents" decoration-info="state == 'submitted'" decoration-success="state == 'received'">
                <field name="name"/>
                <field name="date_required"/>
                <field name="outlet_id"/>
                <field name="kitchen_id" optional="hide"/>
                <field name="line_count"/>
                <field name="total_requested"/>
                <field name="total_approved"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_rk_indent_form" model="ir.ui.view">
        <field name="name">rk.indent.form</field>
        <field name="model">rk.indent</field>
        <field name="arch" type="xml">
            <form string="Indent">
                <header>
                    <button name="action_fill_from_par" type="object" string="Fill from par levels" class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-secondary" invisible="state != 'submitted'"/>
                    <button name="action_reset_draft" type="object" string="Reset" class="btn-secondary" invisible="state not in ('rejected', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ('received', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,planned,received"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="outlet_id"/>
                            <field name="kitchen_id"/>
                            <field name="date_required"/>
                        </group>
                        <group>
                            <field name="requested_by_id"/>
                            <field name="approved_by_id"/>
                            <field name="production_plan_id" invisible="not production_plan_id"/>
                            <field name="total_requested"/>
                            <field name="total_approved"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="par_qty" readonly="1"/>
                                    <field name="qty_on_hand" readonly="1"/>
                                    <field name="qty_requested"/>
                                    <field name="qty_approved"/>
                                    <field name="qty_dispatched" readonly="1"/>
                                    <field name="qty_received" readonly="1"/>
                                    <field name="value" readonly="1" optional="hide"/>
                                    <field name="note"/>
                                    <field name="uom_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Dispatches" name="dispatches" invisible="not dispatch_ids">
                            <field name="dispatch_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="total_qty"/>
                                    <field name="variance_qty"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_rk_indent_search" model="ir.ui.view">
        <field name="name">rk.indent.search</field>
        <field name="model">rk.indent</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="outlet_id"/>
                <filter name="filter_pending" string="Awaiting approval" domain="[('state', '=', 'submitted')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_outlet" string="Outlet" context="{'group_by': 'outlet_id'}"/>
                    <filter name="group_date" string="Required date" context="{'group_by': 'date_required'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_rk_indent" model="ir.actions.act_window">
        <field name="name">Indents</field>
        <field name="res_model">rk.indent</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rk_indent_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Raise an indent</p>
            <p>Outlets request, the central kitchen approves, production plans consolidate.</p>
        </field>
    </record>
</odoo>

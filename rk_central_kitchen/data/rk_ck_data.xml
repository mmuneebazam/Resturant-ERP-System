<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_rk_indent" model="ir.sequence">
        <field name="name">Indent</field>
        <field name="code">rk.indent</field>
        <field name="prefix">IND/%(year)s/</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_rk_production_plan" model="ir.sequence">
        <field name="name">Production plan</field>
        <field name="code">rk.production.plan</field>
        <field name="prefix">CKP/%(year)s/</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_rk_dispatch" model="ir.sequence">
        <field name="name">Dispatch</field>
        <field name="code">rk.dispatch</field>
        <field name="prefix">DSP/%(year)s/</field>
        <field name="padding">5</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_rk_reservation" model="ir.sequence">
        <field name="name">Reservation</field>
        <field name="code">rk.reservation</field>
        <field name="prefix">RSV/%(year)s/</field>
        <field name="padding">5</field>
    </record>
    <record id="cron_rk_reservation_no_show" model="ir.cron">
        <field name="name">Restaurant Kit: flag no-shows</field>
        <field name="model_id" ref="model_rk_reservation"/>
        <field name="state">code</field>
        <field name="code">model._cron_flag_no_shows()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rk_reservation_list" model="ir.ui.view">
        <field name="name">rk.reservation.list</field>
        <field name="model">rk.reservation</field>
        <field name="arch" type="xml">
            <list string="Reservations" decoration-info="state == 'confirmed'" decoration-success="state == 'seated'" decoration-muted="state in ('cancelled', 'no_show')">
                <field name="name"/>
                <field name="start"/>
                <field name="guest_name"/>
                <field name="party_size" sum="Covers"/>
                <field name="outlet_id"/>
                <field name="table_id"/>
                <field name="channel"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_rk_reservation_form" model="ir.ui.view">
        <field name="name">rk.reservation.form</field>
        <field name="model">rk.reservation</field>
        <field name="arch" type="xml">
            <form string="Reservation">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_seat" type="object" string="Seat guest" class="btn-primary" invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-secondary" invisible="state != 'seated'"/>
                    <button name="action_no_show" type="object" string="No-show" class="btn-secondary" invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ('completed', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset" class="btn-secondary" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,seated,completed"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="guest_name"/>
                            <field name="phone"/>
                            <field name="party_size"/>
                            <field name="channel"/>
                        </group>
                        <group>
                            <field name="outlet_id"/>
                            <field name="start"/>
                            <field name="duration_minutes"/>
                            <field name="end"/>
                            <field name="table_id"/>
                            <field name="table_seats"/>
                            <field name="pos_order_id" invisible="not pos_order_id"/>
                        </group>
                    </group>
                    <group string="Deposit">
                        <field name="deposit_required"/>
                        <field name="deposit_amount" invisible="not deposit_required"/>
                        <field name="deposit_paid" invisible="not deposit_required"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <field name="special_requests" placeholder="Allergies, birthday, high chair…"/>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_rk_reservation_search" model="ir.ui.view">
        <field name="name">rk.reservation.search</field>
        <field name="model">rk.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="guest_name"/>
                <field name="phone"/>
                <field name="outlet_id"/>
                <filter name="filter_today" string="Today" domain="[('start', '&gt;=', (context_today()).strftime('%Y-%m-%d 00:00:00')), ('start', '&lt;=', (context_today()).strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter name="filter_upcoming" string="Upcoming" domain="[('start', '&gt;=', datetime.datetime.now())]"/>
                <filter name="filter_no_show" string="No-shows" domain="[('state', '=', 'no_show')]"/>
                <group>
                    <filter name="group_outlet" string="Outlet" context="{'group_by': 'outlet_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_channel" string="Channel" context="{'group_by': 'channel'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_rk_reservation" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">rk.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rk_reservation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Take a booking</p>
            <p>Tables cannot be double-booked inside their turn time.</p>
        </field>
    </record>
</odoo>

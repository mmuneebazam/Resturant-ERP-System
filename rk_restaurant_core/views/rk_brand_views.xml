<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rk_brand_list" model="ir.ui.view">
        <field name="name">rk.brand.list</field>
        <field name="model">rk.brand</field>
        <field name="arch" type="xml">
            <list string="Brands" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="outlet_count" string="Outlets"/>
                <field name="target_food_cost_pct" widget="percentage"/>
                <field name="target_labour_cost_pct" widget="percentage"/>
                <field name="target_prime_cost_pct" widget="percentage"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_rk_brand_form" model="ir.ui.view">
        <field name="name">rk.brand.form</field>
        <field name="model">rk.brand</field>
        <field name="arch" type="xml">
            <form string="Brand">
                <header>
                    <button name="action_open_outlets" type="object" string="Outlets" class="btn-secondary" icon="fa-store"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Brand"/>
                        <h1><field name="name" placeholder="e.g. Blaze Burger"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="color" widget="color_picker"/>
                            <field name="target_food_cost_pct" widget="percentage"/>
                            <field name="target_labour_cost_pct" widget="percentage"/>
                            <field name="target_prime_cost_pct" widget="percentage"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Cost targets">
                            <field name="target_food_cost_pct" widget="percentage"/>
                            <field name="target_labour_cost_pct" widget="percentage"/>
                            <field name="target_prime_cost_pct" widget="percentage"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Outlets" name="outlets">
                            <field name="outlet_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="format"/>
                                    <field name="company_id"/>
                                    <field name="seats"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="description" placeholder="Positioning, menu strategy, price band…"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rk_brand_search" model="ir.ui.view">
        <field name="name">rk.brand.search</field>
        <field name="model">rk.brand</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rk_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">rk.brand</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

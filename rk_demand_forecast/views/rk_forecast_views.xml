<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rk_forecast_list" model="ir.ui.view">
        <field name="name">rk.forecast.list</field>
        <field name="model">rk.forecast</field>
        <field name="arch" type="xml">
            <list string="Forecasts" editable="bottom" decoration-danger="qty_actual and error_pct &gt; 30">
                <field name="date"/>
                <field name="outlet_id"/>
                <field name="product_id"/>
                <field name="daypart_id"/>
                <field name="qty_forecast"/>
                <field name="qty_override"/>
                <field name="qty_planned" readonly="1"/>
                <field name="suggested_prep" readonly="1" optional="show"/>
                <field name="qty_actual" readonly="1"/>
                <field name="accuracy" readonly="1" optional="show"/>
                <field name="error_pct" readonly="1" optional="hide"/>
                <field name="state" widget="badge" readonly="1"/>
                <field name="method" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_rk_forecast_pivot" model="ir.ui.view">
        <field name="name">rk.forecast.pivot</field>
        <field name="model">rk.forecast</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="outlet_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="date" type="col" interval="day"/>
                <field name="qty_planned" type="measure"/>
                <field name="qty_actual" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_rk_forecast_search" model="ir.ui.view">
        <field name="name">rk.forecast.search</field>
        <field name="model">rk.forecast</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="outlet_id"/>
                <filter name="filter_tomorrow" string="Tomorrow" domain="[('date', '=', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_today" string="Today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_closed" string="With actuals" domain="[('state', '=', 'closed')]"/>
                <group>
                    <filter name="group_outlet" string="Outlet" context="{'group_by': 'outlet_id'}"/>
                    <filter name="group_daypart" string="Day-part" context="{'group_by': 'daypart_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_rk_forecast" model="ir.actions.act_window">
        <field name="name">Forecasts</field>
        <field name="res_model">rk.forecast</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="search_view_id" ref="view_rk_forecast_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Generate a forecast</p>
            <p>Forecasts use the same weekday over recent weeks. Override what you know better.</p>
        </field>
    </record>
</odoo>

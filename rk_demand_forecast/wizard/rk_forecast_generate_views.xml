<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rk_forecast_generate_form" model="ir.ui.view">
        <field name="name">rk.forecast.generate.form</field>
        <field name="model">rk.forecast.generate</field>
        <field name="arch" type="xml">
            <form string="Generate forecasts">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="weeks"/>
                    </group>
                    <group>
                        <field name="outlet_ids" widget="many2many_tags"/>
                        <field name="daypart_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_rk_forecast_generate" model="ir.actions.act_window">
        <field name="name">Generate forecasts</field>
        <field name="res_model">rk.forecast.generate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
